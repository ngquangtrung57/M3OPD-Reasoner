+++ b/test/utils/test_flops_counter.py
@@ -0,0 +1,53 @@
+import unittest
+
+from transformers import PretrainedConfig
+
+from lmms_engine.models.utils import FlopsCounter
+
+
+def _qwen3_5_config(layer_types):
+    text_config = PretrainedConfig(
+        hidden_size=64,
+        vocab_size=1000,
+        num_hidden_layers=len(layer_types),
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=16,
+        intermediate_size=128,
+        layer_types=layer_types,
+        linear_num_key_heads=4,
+        linear_num_value_heads=8,
+        linear_key_head_dim=16,
+        linear_value_head_dim=16,
+        linear_conv_kernel_dim=4,
+    )
+    config = PretrainedConfig(text_config=text_config.to_dict())
+    config.model_type = "qwen3_5"
+    config.text_config = text_config
+    return config
+
+
+class TestQwen3_5FlopsCounter(unittest.TestCase):
+    def test_qwen3_5_is_counted(self):
+        counter = FlopsCounter(_qwen3_5_config(["linear_attention"] * 3 + ["full_attention"]))
+        self.assertEqual(counter.estimate_func[counter.config.model_type], counter._estimate_qwen3_5_flops)
+        flops, raw_flops = counter._estimate_qwen3_5_flops(300, [100, 200], 1.0)
+        self.assertGreater(flops, 0)
+        self.assertGreater(raw_flops, 0)
+
+    def test_quadratic_term_only_in_full_attention_layers(self):
+        # With no full-attention layer the cost is linear in the sequence length.
+        counter = FlopsCounter(_qwen3_5_config(["linear_attention"] * 4))
+        _, one_long = counter._estimate_qwen3_5_flops(200, [200], 1.0)
+        _, two_short = counter._estimate_qwen3_5_flops(200, [100, 100], 1.0)
+        self.assertEqual(one_long, two_short)
+
+        counter = FlopsCounter(_qwen3_5_config(["linear_attention"] * 3 + ["full_attention"]))
+        _, one_long = counter._estimate_qwen3_5_flops(200, [200], 1.0)
+        _, two_short = counter._estimate_qwen3_5_flops(200, [100, 100], 1.0)
+        # 12 * (200^2 - 2 * 100^2) * head_dim * heads * full layers
+        self.assertEqual(one_long - two_short, 12 * 20000 * 16 * 4 * 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
