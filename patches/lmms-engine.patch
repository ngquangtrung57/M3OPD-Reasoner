+ASSISTANT_OPEN = "<|im_start|>assistant\n"
+THINK_OPEN = "<think>\n"
+THINK_CLOSE = "\n</think>\n\n"
+EMPTY_THINK = "<think>\n\n</think>\n\n"
+IM_END = "<|im_end|>"
+
+
+def split_think(text: str):
+    """(reasoning, content) of an assistant text exactly as the native Qwen3.5 chat template splits it:
+    content is trimmed; with a </think> the reasoning is the part before it (trimmed), the content the part after it."""
+    content = text.strip()
+    if "</think>" in content:
+        reasoning = content.split("</think>")[0].rstrip("\n").split("<think>")[-1].lstrip("\n").strip()
+        content = content.split("</think>")[-1].lstrip("\n")
+        return reasoning, content
+    return "", content
