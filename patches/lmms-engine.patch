+def check_video_reader(meta: dict, path: str) -> None:
+    """qwen_vl_utils falls back to torchvision when the forced reader (FORCE_QWENVL_VIDEO_READER = the configured
+    video reader) fails, which changes the frames silently. Raise (default) or warn (MOPD_VIDEO_READER_CHECK=warn)."""
+    want = os.environ.get("FORCE_QWENVL_VIDEO_READER")
+    got = (meta or {}).get("video_backend")
