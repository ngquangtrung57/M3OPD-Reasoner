+        return
+    msg = f"video {path} decoded with {got!r}, configured reader is {want!r} (qwen_vl_utils fell back)"
+    if os.environ.get("MOPD_VIDEO_READER_CHECK", "raise") == "warn":
+        logger.warning(msg)
+        return
+    raise RuntimeError(msg)
