+    from verl.utils.metric.utils import Metric
+
+    empty = compute_distillation_loss_range(losses, torch.zeros(1, 6, dtype=torch.bool))
+    full = compute_distillation_loss_range(losses, torch.ones(1, 6, dtype=torch.bool))
+    assert set(empty) == set(full) == {"distillation/loss_min", "distillation/loss_max"}
