+def test_masked_vocab_entries():
+    """-inf logits (masked vocab) at non-selected positions keep value and gradient finite and exact."""
+    torch.manual_seed(5)
+    B, T, V, K = 1, 4, 32, 3
+    base = torch.randn(B, T, V, dtype=torch.float64)
+    base[..., 16:] = float("-inf")
+    topk_ids = torch.randint(0, 16, (B, T, K))
+    x = base.float().requires_grad_(True)
+    out = _chunked_topk_log_probs(x, topk_ids, chunk_size=2)
+    out.sum().backward()
+    x_ref = base.clone().requires_grad_(True)
+    ref = _reference_topk_log_probs(x_ref, topk_ids)
+    ref.sum().backward()
+    assert torch.isfinite(out).all() and torch.isfinite(x.grad).all()
+    assert (out.double() - ref).abs().max().item() <= 1e-5
+    assert (x.grad.double() - x_ref.grad).abs().max().item() <= 1e-5
