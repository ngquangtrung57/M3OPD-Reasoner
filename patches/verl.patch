+"""Resume must re-yield the prefetched, untrained prompts when the TQ buffer cannot be checkpointed."""
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+from omegaconf import OmegaConf
+from torchdata.stateful_dataloader import StatefulDataLoader
+
+from verl.trainer.ppo.v1 import trainer_base
+from verl.trainer.ppo.v1.trainer_base import PPOTrainer
+
+N_PROMPTS, TRAIN_BS = 40, 4
+
+
+def _collate(rows):
+    return {"raw_prompt": np.array([r for r in rows], dtype=object), "id": torch.tensor(rows)}
+
+
+def _stub(gen_bs, state=None, base_step=0, trainer_mode="colocate_async"):
+    dl = StatefulDataLoader(list(range(N_PROMPTS)), batch_size=gen_bs, shuffle=True, collate_fn=_collate,
+                           generator=torch.Generator().manual_seed(7))
+    if state is not None:
+        dl.load_state_dict(state)
+    stub = SimpleNamespace(
+        config=OmegaConf.create({"data": {"train_batch_size": TRAIN_BS}}),
+        train_dataloader=dl,
+        train_dataloader_it=None,
+        trainer_mode=trainer_mode,
+        global_steps=base_step + 1,
+        _dl_snapshots={},
+        _dl_fetched=0,
+        _dl_base_step=base_step,
+    )
+    stub._fetch_one_gen_batch = PPOTrainer._fetch_one_gen_batch.__get__(stub)
+    stub._dataloader_state_for_save = PPOTrainer._dataloader_state_for_save.__get__(stub)
+    return stub
+
+
+def _draw(stub, num_prompts, gen_bs):
+    ids = []
+    for _ in range(num_prompts // gen_bs):
+        ids += stub._fetch_one_gen_batch()["id"].tolist()
+    return ids
+
+
+@pytest.mark.parametrize("gen_bs", [4, 2])
+def test_resume_re_yields_untrained_prefetched_prompts(monkeypatch, gen_bs):
+    monkeypatch.setattr(trainer_base, "_tq_supports_checkpoint", lambda: False)
+    run = _stub(gen_bs)
+    fetched = _draw(run, TRAIN_BS, gen_bs)  # warmup window: one batch ahead
+    trained, save_step = [], 3
+    for step in range(1, save_step + 1):
+        run.global_steps = step
+        fetched += _draw(run, TRAIN_BS, gen_bs)  # prepare_step prefetch: window is 2 batches during step
+        trained += fetched[(step - 1) * TRAIN_BS : step * TRAIN_BS]  # in-order consumption
+    run.global_steps = save_step
+    state = run._dataloader_state_for_save()
+    # the current position is past the prefetched batches; the saved one is not.
+    assert run.train_dataloader.state_dict() != state
+
+    resumed = _stub(gen_bs, state=state, base_step=save_step)
+    after = _draw(resumed, TRAIN_BS, gen_bs)
+    for step in range(save_step + 1, save_step + 4):
+        resumed.global_steps = step
+        after += _draw(resumed, TRAIN_BS, gen_bs)
+    trained_after = after[: 3 * TRAIN_BS]
+    seen = trained + trained_after
+    assert len(seen) == len(set(seen)) == (save_step + 3) * TRAIN_BS
+    assert seen == fetched[: save_step * TRAIN_BS] + trained_after
+    assert after[:TRAIN_BS] == fetched[save_step * TRAIN_BS : (save_step + 1) * TRAIN_BS]
+
+
+def test_tq_checkpoint_support_keeps_current_position(monkeypatch):
+    monkeypatch.setattr(trainer_base, "_tq_supports_checkpoint", lambda: True)
+    run = _stub(4)
+    _draw(run, 2 * TRAIN_BS, 4)
+    run.global_steps = 1
+    assert run._dataloader_state_for_save() == run.train_dataloader.state_dict()
