+def rollout_window_metrics(
+    groups: Iterable[tuple[float, float | None, int]],
+    window_start: float,
+    window_end: float,
+    n_rollout_gpus: int,
+    prefix: str = "separate_async/rollout",
+) -> dict[str, float]:
+    """Reduce prompt-group activity over ``[window_start, window_end]``.
+
+    Args:
+        groups: ``(start_ts, end_ts or None while running, response tokens of the group)``.
+        n_rollout_gpus: GPUs of the standalone rollout pool (throughput denominator).
+
+    Returns:
+        idle_ratio: share of the window with no group in flight.
+        inflight_groups_mean: time-averaged number of groups in flight.
+        groups_finished, group_latency_mean_s / max_s: groups whose end falls in the window.
+        gen_tokens_per_s_per_gpu: response tokens of the finished groups / window / rollout GPUs.
