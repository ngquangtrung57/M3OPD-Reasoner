+# limitations under the License.
+"""CPU tests for compute_per_source_train_metrics (training_ds/<ds>/* metrics).
+
+Fake batch, B=5 rows, response width L=4, two sources. Every number below is checked by hand:
+
+    row  source  resp_len  score  adv   acc
+     0   imgr    4         1.0     0.5  1.0
+     1   imgr    2         0.0    -0.5  0.0
+     2   vid     4         1.0     1.0  1.0
+     3   vid     3         0.5     0.0  (no acc)
+     4   vid     0 (abort) 0.0     0.0  0.0
+
+Advantages outside the response mask are 9.0 so a mask bug shows up.
+"""
+
+import pytest
+import torch
+from tensordict import TensorDict
+
+from verl import DataProto
+from verl.trainer.ppo.metric_utils import compute_per_source_train_metrics
+
+LENGTHS = [4, 2, 4, 3, 0]
+SCORES = [1.0, 0.0, 1.0, 0.5, 0.0]
+ADVS = [0.5, -0.5, 1.0, 0.0, 0.0]
+SOURCES = ["imgr", "imgr", "vid", "vid", "vid"]
+EXTRA_FIELDS = [
+    {"reward_extra_info": {"acc": 1.0}},
+    {"reward_extra_info": {"acc": 0.0}},
+    {"reward_extra_info": {"acc": 1.0}},
+    {"reward_extra_info": {}},
+    {"reward_extra_info": {"acc": 0.0}},
+]
+L = 4
+
+
+def _make_batch() -> DataProto:
+    n = len(LENGTHS)
+    mask = torch.zeros(n, L)
+    scores = torch.zeros(n, L)
+    advantages = torch.full((n, L), 9.0)
+    for i, length in enumerate(LENGTHS):
+        mask[i, :length] = 1
+        if length > 0:
+            scores[i, length - 1] = SCORES[i]  # the sequence score sits on the last response token
+        advantages[i, :length] = ADVS[i]
+    data = TensorDict(
+        {
+            "responses": torch.zeros(n, L, dtype=torch.int64),
+            "response_mask": mask,
+            "token_level_scores": scores,
+            "advantages": advantages,
+            "prompt_length": torch.full((n,), 5.0),
+            "response_length": torch.tensor(LENGTHS, dtype=torch.float32),
+        },
+        batch_size=[n],
+    )
+    return DataProto(batch=data)
+
+
+def test_two_sources_values_by_hand():
+    out = compute_per_source_train_metrics(_make_batch(), SOURCES, EXTRA_FIELDS, max_response_length=L)
+
+    # imgr: rows 0,1. 6 response tokens (4+2), total batch 13 (4+2+4+3+0).
+    assert out["training_ds/imgr/n_samples"] == 2
+    assert out["training_ds/imgr/sample_share"] == pytest.approx(2 / 5)
+    assert out["training_ds/imgr/token_share"] == pytest.approx(6 / 13)
+    assert out["training_ds/imgr/score/mean"] == pytest.approx(0.5)
+    assert out["training_ds/imgr/acc/mean"] == pytest.approx(0.5)
+    assert out["training_ds/imgr/response_length/mean"] == pytest.approx(3.0)
+    assert out["training_ds/imgr/response_length/clip_ratio"] == pytest.approx(0.5)  # only row 0 hits 4
+    assert out["training_ds/imgr/advantages/abs_mean"] == pytest.approx((0.5 * 4 + 0.5 * 2) / 6)
+    assert out["training_ds/imgr/advantages/zero_frac"] == pytest.approx(0.0)
+
+    # vid: rows 2,3,4. 7 response tokens (4+3+0). The aborted row 4 leaves the score mean but not the counts.
+    assert out["training_ds/vid/n_samples"] == 3
+    assert out["training_ds/vid/sample_share"] == pytest.approx(3 / 5)
+    assert out["training_ds/vid/token_share"] == pytest.approx(7 / 13)
+    assert out["training_ds/vid/score/mean"] == pytest.approx((1.0 + 0.5) / 2)
+    assert out["training_ds/vid/acc/mean"] == pytest.approx((1.0 + 0.0) / 2)  # row 3 has no acc
+    assert out["training_ds/vid/response_length/mean"] == pytest.approx(7 / 3)
+    assert out["training_ds/vid/response_length/clip_ratio"] == pytest.approx(1 / 3)
+    assert out["training_ds/vid/advantages/abs_mean"] == pytest.approx(4 / 7)  # only row 2 has |adv| > 0
+    assert out["training_ds/vid/advantages/zero_frac"] == pytest.approx(3 / 7)  # row 3's 3 tokens
+
+    assert out["training_ds/imgr/token_share"] + out["training_ds/vid/token_share"] == pytest.approx(1.0)
+    assert out["training_ds/imgr/sample_share"] + out["training_ds/vid/sample_share"] == pytest.approx(1.0)
+
+
+def test_max_response_length_override_and_default():
+    # Cap 3: only row 3 (length 3) is at the cap; the padded width 4 is the default cap.
+    capped = compute_per_source_train_metrics(_make_batch(), SOURCES, max_response_length=3)
+    assert capped["training_ds/imgr/response_length/clip_ratio"] == pytest.approx(0.0)
+    assert capped["training_ds/vid/response_length/clip_ratio"] == pytest.approx(1 / 3)
+    default = compute_per_source_train_metrics(_make_batch(), SOURCES)
+    assert default["training_ds/imgr/response_length/clip_ratio"] == pytest.approx(0.5)
+
+
+def test_acc_key_absent_without_acc():
+    out = compute_per_source_train_metrics(_make_batch(), SOURCES)  # no extra_fields at all
+    assert not [k for k in out if k.endswith("/acc/mean")]
+    no_acc = [{"reward_extra_info": {}}, None, {}, {"reward_extra_info": None}, {"other": 1}]
+    out = compute_per_source_train_metrics(_make_batch(), SOURCES, no_acc)
+    assert not [k for k in out if k.endswith("/acc/mean")]
+    assert out["training_ds/imgr/n_samples"] == 2
+
+
+def test_single_source_batch():
+    out = compute_per_source_train_metrics(_make_batch(), ["imgr"] * 5, EXTRA_FIELDS, max_response_length=L)
+    assert {k.split("/")[1] for k in out} == {"imgr"}
+    assert out["training_ds/imgr/n_samples"] == 5
+    assert out["training_ds/imgr/sample_share"] == pytest.approx(1.0)
+    assert out["training_ds/imgr/token_share"] == pytest.approx(1.0)
+    assert out["training_ds/imgr/response_length/mean"] == pytest.approx(13 / 5)
+    assert out["training_ds/imgr/score/mean"] == pytest.approx((1.0 + 0.0 + 1.0 + 0.5) / 4)  # non-aborted rows
+
+
+def test_none_source_entry_is_unknown():
+    out = compute_per_source_train_metrics(_make_batch(), ["imgr", None, "vid", "vid", "vid"])
+    assert out["training_ds/unknown/n_samples"] == 1
+    assert out["training_ds/imgr/n_samples"] == 1
+
+
+@pytest.mark.parametrize("data_sources", [None, [], ["imgr", "vid"]])
+def test_missing_or_mismatched_data_source_returns_empty(data_sources):
+    # No data_source, empty, or length != batch size: no metrics and no exception.
+    assert compute_per_source_train_metrics(_make_batch(), data_sources, EXTRA_FIELDS) == {}
+
+
+def test_all_aborted_source_skips_score_and_adv():
+    batch = _make_batch()
+    out = compute_per_source_train_metrics(batch, ["a", "a", "a", "a", "b"])
+    assert out["training_ds/b/n_samples"] == 1
+    assert out["training_ds/b/response_length/mean"] == pytest.approx(0.0)
+    assert out["training_ds/b/token_share"] == pytest.approx(0.0)
+    assert "training_ds/b/score/mean" not in out
+    assert "training_ds/b/advantages/abs_mean" not in out
