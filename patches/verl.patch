+async def _with_teacher_retry(call, attempts: int = _TEACHER_ATTEMPTS, base_delay_s: float = 2.0):
+    """Retry a teacher call on transient errors (replica restart, connection reset); deterministic errors
+    (length mismatch, routing key) and the last failure propagate and fail the run."""
+    for attempt in range(attempts):
+        try:
+            return await call()
+        except (TeacherError, AssertionError, ValueError, KeyError, TypeError):
+            raise
+        except Exception as e:
+            if attempt == attempts - 1:
+                raise
+            logger.warning(f"teacher call failed ({type(e).__name__}: {e}); retry {attempt + 1}")
+            await asyncio.sleep(base_delay_s * 2**attempt)
