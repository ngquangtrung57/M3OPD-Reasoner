+def test_window_metrics_union_concurrency_latency_tokens():
+    # window [0, 10]: groups busy on [1, 4] and [3, 6] -> busy 5 s; one still running from 8
+    groups = [(1.0, 4.0, 100), (3.0, 6.0, 300), (8.0, None, 999), (-5.0, -1.0, 7)]
+    m = rollout_window_metrics(groups, 0.0, 10.0, n_rollout_gpus=2)
+    assert m[f"{P}/idle_ratio"] == pytest.approx(1 - 7 / 10)  # [1, 6] + [8, 10]
+    assert m[f"{P}/inflight_groups_mean"] == pytest.approx((3 + 3 + 2) / 10)
+    assert m[f"{P}/groups_finished"] == 2  # the group that ended before the window does not count
+    assert m[f"{P}/group_latency_mean_s"] == pytest.approx(3.0)
+    assert m[f"{P}/group_latency_max_s"] == pytest.approx(3.0)
+    assert m[f"{P}/gen_tokens_per_s_per_gpu"] == pytest.approx(400 / 10 / 2)
