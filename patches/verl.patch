+def compute_per_source_train_metrics(
+    batch: DataProto,
+    data_sources: Any,
+    extra_fields: Any = None,
+    max_response_length: int | None = None,
+) -> dict[str, float]:
+    """Per-data_source training metrics (``training_ds/<ds>/*``) for batches that mix several domains.
+
+    CPU only, built from tensors already in the batch. Returns ``{}`` when ``data_sources`` is missing or does not
+    match the batch size. Keys, for every data_source present in the batch:
+        - n_samples, sample_share, token_share (share of the response tokens of the batch)
+        - score/mean: summed ``token_level_scores`` per sequence, non-aborted samples only (key absent if none)
+        - acc/mean: mean of ``extra_fields[i]["reward_extra_info"]["acc"]`` (key absent if no sample has it)
+        - response_length/mean, response_length/clip_ratio (share at ``max_response_length``, default the
+          padded response width)
+        - advantages/abs_mean: mean |advantage| over response tokens
+        - advantages/zero_frac: share of response tokens with advantage == 0
+    """
+    if data_sources is None:
+        return {}
+    sources = [str(d) if d is not None else "unknown" for d in data_sources]
+    n = len(sources)
+    if n == 0 or n != batch.batch["responses"].shape[0]:
+        return {}
+
+    sequence_score = batch.batch["token_level_scores"].sum(-1).float()
+    advantages = batch.batch["advantages"].float()
+    response_mask = batch.batch["response_mask"].bool()
+    response_length = _compute_response_info(batch)["response_length"].float()
+    cap = max_response_length if max_response_length else batch.batch["responses"].shape[-1]
+
+    abs_adv_sum = (advantages.abs() * response_mask).sum(-1)
+    zero_adv_count = ((advantages == 0) & response_mask).sum(-1).float()
+    n_tokens = response_mask.sum(-1).float()
+    total_response_tokens = max(response_length.sum().item(), 1.0)
+
+    acc = np.full(n, np.nan)
+    if extra_fields is not None:
+        for i, extra in enumerate(extra_fields):
+            extra = getattr(extra, "data", extra)  # NonTensorData wrapper
+            info = extra.get("reward_extra_info") if isinstance(extra, dict) else None
+            try:
+                acc[i] = float(info["acc"])
+            except (TypeError, KeyError, ValueError):
+                pass
+
+    metrics: dict[str, float] = {}
+    sources_arr = np.asarray(sources, dtype=object)
+    for source in dict.fromkeys(sources):
+        idx = torch.from_numpy(np.nonzero(sources_arr == source)[0])
+        pfx = f"training_ds/{source}"
+        length = response_length[idx]
+        tokens = n_tokens[idx].sum().item()
+        metrics[f"{pfx}/n_samples"] = len(idx)
+        metrics[f"{pfx}/sample_share"] = len(idx) / n
+        metrics[f"{pfx}/token_share"] = length.sum().item() / total_response_tokens
+        metrics[f"{pfx}/response_length/mean"] = length.mean().item()
+        metrics[f"{pfx}/response_length/clip_ratio"] = torch.eq(length, cap).float().mean().item()
+        non_aborted = length > 0
+        if non_aborted.any():
+            metrics[f"{pfx}/score/mean"] = sequence_score[idx][non_aborted].mean().item()
+        source_acc = acc[idx.numpy()]
+        if not np.isnan(source_acc).all():
+            metrics[f"{pfx}/acc/mean"] = float(np.nanmean(source_acc))
+        if tokens > 0:
+            metrics[f"{pfx}/advantages/abs_mean"] = abs_adv_sum[idx].sum().item() / tokens
+            metrics[f"{pfx}/advantages/zero_frac"] = zero_adv_count[idx].sum().item() / tokens
+    return metrics
+
