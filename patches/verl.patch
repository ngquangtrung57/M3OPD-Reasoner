+    intervals = []
+    overlap_sum = 0.0
+    latencies = []
+    tokens = 0
+    for start, end, n_tokens in groups:
+        stop = window_end if end is None else end
+        lo, hi = max(start, window_start), min(stop, window_end)
+        if hi > lo:
+            intervals.append((lo, hi))
+            overlap_sum += hi - lo
+        if end is not None and window_start < end <= window_end:
+            latencies.append(end - start)
+            tokens += n_tokens
+
+    busy = 0.0
+    cur_lo = cur_hi = None
+    for lo, hi in sorted(intervals):
+        if cur_hi is None or lo > cur_hi:
+            if cur_hi is not None:
+                busy += cur_hi - cur_lo
