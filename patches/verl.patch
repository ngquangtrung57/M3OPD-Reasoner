+def test_matches_float64_reference_with_repeated_ids(dtype, atol, chunk_size):
+    """Values and gradients match float64 log_softmax+gather; repeated ids accumulate in the gradient."""
+    torch.manual_seed(11)
+    B, T, V, K = 2, 5, 64, 6
+    base = torch.randn(B, T, V, dtype=dtype)
+    topk_ids = torch.randint(0, V, (B, T, K))
+    topk_ids[..., 1] = topk_ids[..., 0]  # repeated ids
+    w = torch.randn(B, T, K, dtype=torch.float64)
+
+    x = base.clone().requires_grad_(True)
+    out = _chunked_topk_log_probs(x, topk_ids, chunk_size=chunk_size)
+    assert out.dtype == torch.float32
+    (out.double() * w).sum().backward()
+
+    x_ref = base.double().requires_grad_(True)
+    ref = _reference_topk_log_probs(x_ref, topk_ids)
+    (ref * w).sum().backward()
+
+    assert (out.double() - ref).abs().max().item() <= atol
+    assert x.grad.dtype == dtype
+    assert (x.grad.double() - x_ref.grad).abs().max().item() <= (atol if dtype == torch.float32 else 2e-2)
