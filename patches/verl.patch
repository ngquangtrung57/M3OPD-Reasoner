+def test_buffer_collects_stamps_and_tokens_and_prunes(monkeypatch):
+    listing = {
+        "train": {
+            "a": {"is_prompt": True, "status": "finished", "global_steps": 1, "rollout_start_ts": 1.0,
+                  "rollout_end_ts": 4.0},
+            "a_0_0": {"is_prompt": False, "status": "success", "response_len": 10},
+            "a_1_0": {"is_prompt": False, "status": "success", "response_len": 30},
+            "b": {"is_prompt": True, "status": "running", "global_steps": 1, "rollout_start_ts": 3.0,
+                  "rollout_end_ts": 2.0},  # stale end stamp of a reissued group
+            "c": {"is_prompt": True, "status": "pending", "global_steps": 1},
+        }
+    }
+    monkeypatch.setattr(rb_module.tq, "kv_list", lambda: listing)
+    rb = _rb()
+    rb._sync_metadata_from_transfer_queue()
+    assert rb.inflight_count("train") == 2
+    assert set(rb.rollout_groups) == {"a", "b"}
+    assert rb.rollout_groups["b"]["end"] is None
+
+    m = rb.rollout_activity(0.0, 10.0, n_rollout_gpus=1)
+    assert m[f"{P}/groups_finished"] == 1
+    assert m[f"{P}/gen_tokens_per_s_per_gpu"] == pytest.approx(40 / 10)
+    assert m[f"{P}/idle_ratio"] == pytest.approx(0.1)  # [1, 10] busy, [0, 1] idle
+    assert set(rb.rollout_groups) == {"b"}  # finished group pruned
+
+    # "a" is seen again (not consumed yet): it ended before the next window, so it adds nothing
+    rb._sync_metadata_from_transfer_queue()
+    m = rb.rollout_activity(10.0, 20.0, n_rollout_gpus=1)
+    assert m[f"{P}/groups_finished"] == 0
+    assert m[f"{P}/idle_ratio"] == pytest.approx(0.0)  # "b" still running
