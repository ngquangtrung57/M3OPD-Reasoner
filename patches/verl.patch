+def check_video_reader(videos) -> None:
+    """qwen_vl_utils falls back to torchvision when the forced reader (FORCE_QWENVL_VIDEO_READER = the configured
+    video reader) fails, which changes the frames silently. `videos` = process_vision_info output with
+    return_video_metadata=True. Raise (default) or warn (MOPD_VIDEO_READER_CHECK=warn)."""
+    import logging
+    import os
+
+    want = os.environ.get("FORCE_QWENVL_VIDEO_READER")
+    if not want:
