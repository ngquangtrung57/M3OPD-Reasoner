+_VIDEO_TIMESTAMP = re.compile(r"<(\d+(?:\.\d+)?) seconds>")
+_VIDEO_TIMESTAMP_PREFIXED = re.compile(r"(.*?)<(\d+(?:\.\d+)?) seconds>", re.DOTALL)
+_MAX_TIMESTAMP_TOKENS = 16
+
+
+def _timestamp_before(ids: list[int], end: int, start: int, tokenizer) -> tuple[int, Optional[float], str]:
+    """(length, value, prefix) of the `<t seconds>` token span ending at `end` (not before `start`).
+    `prefix` is text BPE-merged into the span's first token (e.g. ":<"); (0, None, "") if no timestamp."""
+    for k in range(1, min(_MAX_TIMESTAMP_TOKENS, end - start) + 1):
+        m = _VIDEO_TIMESTAMP_PREFIXED.fullmatch(tokenizer.decode(ids[end - k : end]))
+        if m:
+            return k, float(m.group(2)), m.group(1)
+    return 0, None, ""
+
+
+def _collapse_timestamped_videos(ids: list[int], processor) -> list[int]:
+    """Qwen3-VL / Qwen3.5 processors expand each video into per-frame blocks
+    `<t0 seconds><|vision_start|><|video_pad|>..<|vision_end|><t1 seconds>...`, but vLLM's prompt update
+    replaces only ONE `<|vision_start|><|video_pad|><|vision_end|>` per video with the full per-frame
+    expansion. After the pad dedup above, the other frames' blocks would stay in the prompt as text, so
+    vLLM saw a longer, corrupted video prompt (teacher prompt_logprobs length != sequence length).
+    Collapse each video's timestamped frame run back to `<|vision_start|><|video_pad|><|vision_end|>`.
+    Prompts without timestamped frames (Qwen2/2.5-VL, images) are returned unchanged.
+    """
+    tokenizer = getattr(processor, "tokenizer", None)
+    video_id = getattr(processor, "video_token_id", None)
+    if tokenizer is None or video_id is None:
+        return ids
+    vs = tokenizer.convert_tokens_to_ids("<|vision_start|>")
+    ve = tokenizer.convert_tokens_to_ids("<|vision_end|>")
+    if not isinstance(vs, int) or not isinstance(ve, int):
+        return ids
+
+    def is_block(i):
+        return i + 2 < len(ids) and ids[i] == vs and ids[i + 1] == video_id and ids[i + 2] == ve
+
+    out, i, done = [], 0, 0  # done = first index of ids not yet consumed by a collapsed group
+    while i < len(ids):
+        if is_block(i):
+            k, t_prev, prefix = _timestamp_before(ids, i, done, tokenizer)
+            if k:
+                j = i + 3
+                # absorb the following frames of the same video: timestamps never decrease within a video
+                # (%.1f rounding can repeat one); a drop starts a new video. Ambiguous only for directly
+                # adjacent videos whose first one ends before the next one's first timestamp (<~1 s clips).
+                while True:
+                    nxt = None
+                    for k2 in range(1, _MAX_TIMESTAMP_TOKENS + 1):
+                        if is_block(j + k2):
+                            m = _VIDEO_TIMESTAMP.fullmatch(tokenizer.decode(ids[j : j + k2]))
+                            if m and float(m.group(1)) >= t_prev:
+                                nxt = (k2, float(m.group(1)))
+                            break
+                    if nxt is None:
+                        break
+                    j, t_prev = j + nxt[0] + 3, nxt[1]
+                del out[len(out) - k :]
