+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""A separately-wrapped FSDP2 lm_head must get a dp-averaged gradient on the fused-kernel path.
+
+The fused path reads ``lm_head.weight`` as a DTensor and calls ``full_tensor``. The lm_head is its own
+FSDP unit, so its hooks never run and ``full_tensor``'s backward keeps each rank's LOCAL rows unless
+``grad_placements=[Partial("avg")]`` is passed (2-process gloo test).
+"""
+
+import inspect
+import os
+import tempfile
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+import torch.nn as nn
+from torch.distributed.device_mesh import init_device_mesh
+from torch.distributed.fsdp import fully_shard
+from torch.distributed.tensor import DTensor
+from torch.distributed.tensor.placement_types import Partial
+
+
+class _Tiny(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.body = nn.Linear(8, 8, bias=False)
+        self.lm_head = nn.Linear(8, 16, bias=False)
+
+    def forward(self, x, avg_grad):
+        h = self.body(x)
+        w = self.lm_head.weight
+        assert isinstance(w, DTensor)
+        w = w.full_tensor(grad_placements=[Partial("avg")] * w.device_mesh.ndim) if avg_grad else w.full_tensor()
+        return (h @ w.T).logsumexp(-1).sum()
+
+
+def _worker(rank, world_size, init_file, avg_grad, out, mesh_shape):
+    dist.init_process_group("gloo", init_method=f"file://{init_file}", rank=rank, world_size=world_size)
+    torch.manual_seed(0)
+    m, ref = _Tiny(), _Tiny()
+    ref.load_state_dict(m.state_dict())
+    names = ("replicate", "shard") if len(mesh_shape) == 2 else None  # 2 dims = HSDP
+    mesh = init_device_mesh("cpu", mesh_shape, mesh_dim_names=names)
+    fully_shard(m.body, mesh=mesh)
+    fully_shard(m.lm_head, mesh=mesh)  # separate unit, like an untied lm_head in verl
+    fully_shard(m, mesh=mesh)
+    torch.manual_seed(100 + rank)
+    x = torch.randn(4, 8)
+    m(x, avg_grad).backward()
+    h = ref.body(x)
+    (h @ ref.lm_head.weight.T).logsumexp(-1).sum().backward()
+    res = {}
+    for name, p, rp in (("lm_head", m.lm_head.weight, ref.lm_head.weight), ("body", m.body.weight, ref.body.weight)):
+        g_ref = rp.grad.clone()
+        dist.all_reduce(g_ref)
+        g_ref /= world_size
+        res[name] = (p.grad.full_tensor() - g_ref).abs().max().item()
+    if rank == 0:
+        out.put(res)
+    dist.destroy_process_group()
+
+
+def _run(avg_grad, mesh_shape=(2,)):
+    world_size = 1
+    for n in mesh_shape:
+        world_size *= n
+    ctx = mp.get_context("spawn")
+    out = ctx.Queue()
+    with tempfile.TemporaryDirectory() as d:
+        init_file = os.path.join(d, "init")
+        procs = [
+            ctx.Process(target=_worker, args=(r, world_size, init_file, avg_grad, out, mesh_shape))
+            for r in range(world_size)
+        ]
+        for p in procs:
+            p.start()
+        res = out.get(timeout=120)
+        for p in procs:
+            p.join(timeout=60)
+            assert p.exitcode == 0
+    return res
+
+
+def test_lm_head_grad_is_dp_mean_with_partial_avg():
+    res = _run(True)
+    assert res["body"] < 1e-5  # control: FSDP hooks average the body
+    assert res["lm_head"] < 1e-5
+
+
+def test_lm_head_grad_is_global_mean_under_hsdp():
+    res = _run(True, mesh_shape=(2, 2))
+    assert res["body"] < 1e-5
+    assert res["lm_head"] < 1e-5
+
+
+def test_lm_head_grad_is_local_without_partial_avg():
+    # Documents the bug the fix removes: plain full_tensor() keeps the local rows.
+    res = _run(False)
+    assert res["body"] < 1e-5
+    assert res["lm_head"] > 1e-3
+
+
+@pytest.mark.parametrize("name", ["qwen3_5", "qwen3_vl"])
+def test_model_files_use_partial_avg(name):
+    import importlib
+
+    src = inspect.getsource(importlib.import_module(f"verl.models.transformers.{name}"))
+    assert src.count("full_tensor(") == src.count("full_tensor(grad_placements=avg)") >= 1
+    assert '[Partial("avg")] * vocab_weights.device_mesh.ndim' in src
diff --git a/tests/trainer/ppo/test_per_source_train_metrics_on_cpu.py b/tests/trainer/ppo/test_per_source_train_metrics_on_cpu.py
