+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Truncated-response detection, masking and per-domain rollout metrics (pure python, CPU)."""
+
+from collections import defaultdict
+from typing import Iterable, Optional, Sequence
+
+import numpy as np
+
+
+def collect_eos_ids(tokenizer=None, generation_config=None, extra_ids: Optional[Iterable[int]] = None) -> set[int]:
+    """Union of tokenizer eos id, generation_config eos id(s) and extra stop token ids."""
+    ids: set[int] = set()
+
+    def _add(v):
+        if v is None:
+            return
+        # any non-string iterable: list/tuple/set, numpy arrays, OmegaConf ListConfig (stop_token_ids from the config)
+        if isinstance(v, Iterable) and not isinstance(v, (str, bytes)):
+            for x in v:
+                _add(x)
+        else:
+            ids.add(int(v))
+
+    _add(getattr(tokenizer, "eos_token_id", None))
+    _add(getattr(generation_config, "eos_token_id", None))
+    _add(extra_ids)
+    return ids
+
+
+def is_truncated_response(
+    response_ids: Sequence[int],
+    eos_ids: set[int],
+    response_cap: int,
+    finish_reason: Optional[str] = None,
+    prompt_len: int = 0,
+    max_model_len: Optional[int] = None,
+) -> bool:
+    """True when generation stopped without an EOS as the last token because of a length limit.
+
+    Length limit = backend finish reason "length", or valid response length >= response_cap, or
+    prompt_len + response length >= max_model_len (agent loop / engine cut at the context limit).
+    """
+    n = len(response_ids)
+    if n > 0 and int(response_ids[-1]) in eos_ids:
+        return False
+    hit_len = finish_reason == "length" or n >= response_cap
+    if max_model_len is not None and prompt_len + n >= max_model_len:
+        hit_len = True
+    return bool(hit_len)
+
+
+def apply_truncation_mask(response_mask: Sequence[int], truncated: bool, enabled: bool) -> list[int]:
+    """Whole-sample mask: all zeros when enabled and truncated, else the original mask. Length is kept."""
+    if enabled and truncated:
+        return [0] * len(response_mask)
+    return list(response_mask)
+
+
+def domain_rollout_metrics(
+    domains: Sequence,
+    response_lens: Sequence[int],
+    truncated: Sequence[bool],
+    masked: Sequence[bool],
+    think_closed: Optional[Sequence[Optional[bool]]] = None,
+) -> dict:
+    """Overall ``mopd_trunc/*`` and per data_source ``mopd_domain/<ds>/*`` rollout metrics.
+
+    response_lens are the ORIGINAL response lengths (not the masked count). A missing / None domain is
+    "unknown". think_closed entries may be None (token id unknown): that metric is then skipped.
+    """
+    n = len(response_lens)
+    out: dict = {}
+    if n == 0:
+        return out
+    lens = np.asarray(response_lens, dtype=np.float64)
+    trunc = np.asarray(truncated, dtype=bool)
+    msk = np.asarray(masked, dtype=bool)
+    doms = [str(d) if d is not None else "unknown" for d in domains]
+    total_tok = max(lens.sum(), 1.0)
+
+    out["mopd_trunc/frac_truncated"] = float(trunc.mean())
+    out["mopd_trunc/frac_masked"] = float(msk.mean())
+    out["mopd_trunc/masked_token_frac"] = float(lens[msk].sum() / total_tok)
+    # 1.0 when no sample keeps a loss token: the loss is zero (never NaN) but the step is a no-op.
+    out["mopd_trunc/all_masked_batch"] = float(bool(msk.all()))
+
+    idx_by_dom: dict = defaultdict(list)
+    for i, d in enumerate(doms):
+        idx_by_dom[d].append(i)
+    for d, idx in idx_by_dom.items():
+        ix = np.asarray(idx)
+        dl = lens[ix]
+        pfx = f"mopd_domain/{d}"
+        out[f"{pfx}/n"] = len(idx)
+        out[f"{pfx}/token_share"] = float(dl.sum() / total_tok)
+        out[f"{pfx}/resp_len_mean"] = float(dl.mean())
+        out[f"{pfx}/resp_len_p90"] = float(np.percentile(dl, 90))
+        out[f"{pfx}/resp_len_max"] = float(dl.max())
+        out[f"{pfx}/trunc_rate"] = float(trunc[ix].mean())
+        out[f"{pfx}/masked_frac"] = float(msk[ix].mean())
+        out[f"{pfx}/masked_token_frac"] = float(dl[msk[ix]].sum() / max(dl.sum(), 1.0))
+        if think_closed is not None:
+            vals = [think_closed[i] for i in idx if think_closed[i] is not None]
+            if vals:
+                out[f"{pfx}/think_close_rate"] = float(np.mean(vals))
+    return out
