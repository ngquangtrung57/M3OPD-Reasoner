+def _saved_numel(fn, *args):
+    saved = []
+
+    def pack(t):
+        saved.append(t.numel() * t.element_size())
+        return t
+
+    with torch.autograd.graph.saved_tensors_hooks(pack, lambda t: t):
+        fn(*args)
+    return sum(saved)
+
+
+def test_saved_memory_not_above_plain_path():
+    torch.manual_seed(1)
+    B, T, V, K = 2, 16, 512, 8
+    for dtype in (torch.float32, torch.bfloat16):
+        x = torch.randn(B, T, V, dtype=dtype, requires_grad=True)
+        ids = torch.randint(0, V, (B, T, K))
+        plain = _saved_numel(lambda a, i: torch.gather(F.log_softmax(a, dim=-1), -1, i), x, ids)
+        chunked = _saved_numel(lambda a, i: _chunked_topk_log_probs(a, i, chunk_size=4), x, ids)
+        assert chunked <= plain
+        # logits + ids + fp32 logZ only: no [N, V] fp32 copy in bf16.
+        assert chunked <= x.numel() * x.element_size() + ids.numel() * 8 + B * T * 4
