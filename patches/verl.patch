+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""teacher calls retry transient errors and fail at once on deterministic ones."""
+
+import asyncio
+
+import pytest
+
+from verl.experimental.agent_loop.agent_loop import _with_teacher_retry
+
+
+def _flaky(errors, result="ok"):
+    calls = {"n": 0}
+
+    async def call():
+        calls["n"] += 1
+        if errors:
+            raise errors.pop(0)
+        return result
+
+    return call, calls
+
+
+def test_transient_errors_are_retried():
+    call, calls = _flaky([ConnectionResetError("reset"), RuntimeError("replica restart")])
+    assert asyncio.run(_with_teacher_retry(call, attempts=4, base_delay_s=0)) == "ok"
+    assert calls["n"] == 3
+
+
+def test_last_transient_error_propagates():
+    call, calls = _flaky([ConnectionResetError("reset")] * 4)
+    with pytest.raises(ConnectionResetError):
+        asyncio.run(_with_teacher_retry(call, attempts=4, base_delay_s=0))
+    assert calls["n"] == 4
+
+
+@pytest.mark.parametrize("err", [AssertionError("prompt_logprobs length 10 != 11"), ValueError("unknown routing key")])
+def test_deterministic_errors_fail_at_once(err):
+    call, calls = _flaky([err])
+    with pytest.raises(type(err)):
+        asyncio.run(_with_teacher_retry(call, attempts=4, base_delay_s=0))
+    assert calls["n"] == 1
