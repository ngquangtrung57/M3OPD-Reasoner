+# A finished group whose TransferQueue rows were lost (kv_clear index-reuse race) is dropped, not fatal.
+from collections import Counter, defaultdict
+
+import verl.trainer.ppo.v1.replay_buffer as rb
+
+
+def _buffer():
+    b = object.__new__(rb.ReplayBuffer)
+    b.filter_groups_metric = "acc"
+    b.partitions = defaultdict(dict)
+    for name in ("pending_keys", "running_keys", "finished_keys", "failure_keys"):
+        setattr(b, name, defaultdict(set))
+    b.prompt_global_steps = defaultdict(dict)
+    b._dapo_classification_cache = defaultdict(dict)
+    b.lost_group_count = Counter()
+    return b
+
+
+def test_lost_rows_drop_group(monkeypatch):
+    store, cleared = {}, []
+
+    def kv_batch_get(keys, partition_id, select_fields):
+        if any(k not in store for k in keys):
+            raise RuntimeError("StorageUnitData get_data: key 956 not found in field 'extra_fields'")
+        return {"extra_fields": [store[k] for k in keys]}
+
+    monkeypatch.setattr(rb.tq, "kv_batch_get", kv_batch_get)
+    monkeypatch.setattr(rb.tq, "kv_clear", lambda partition_id, keys: cleared.extend(keys))
+    b = _buffer()
+    for uid, accs in (("A", [1, 1]), ("B", [0, 1]), ("C", [1, 0])):
+        b.finished_keys["train"].add(uid)
+        for i, acc in enumerate(accs):
+            key = f"{uid}_0_{i}"
+            b.partitions["train"][key] = {}
+            if not (uid == "C" and i == 1):  # C lost one row
+                store[key] = {"reward_extra_info": {"acc": acc}}
+
+    uids, counts = b._dapo_filtered_keys("train")
+    assert uids == {"A"} and counts == {1.0: 1}
+    assert b.lost_group_count["train"] == 1
+    assert set(cleared) == {"C", "C_0_0", "C_0_1"}
+    assert "C" not in b.finished_keys["train"] and "C_0_0" not in b.partitions["train"]
+    assert b._dapo_classification_cache["train"]["B"] is None
+    assert b._dapo_filtered_keys("train")[0] == {"A"}  # next poll reads nothing new
