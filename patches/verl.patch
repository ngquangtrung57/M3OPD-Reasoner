+        if got is None or got == want:
+            continue
+        msg = f"video decoded with {got!r}, configured reader is {want!r} (qwen_vl_utils fell back)"
+        if os.environ.get("MOPD_VIDEO_READER_CHECK", "raise") == "warn":
+            logging.getLogger(__name__).warning(msg)
